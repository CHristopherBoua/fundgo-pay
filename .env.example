APP_NAME=FundGo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

# --- Paiements (Omnipay) ---------------------------------------------------
# Passerelle par défaut : fake (local, sans réseau) | mollie | stripe
PAYMENTS_GATEWAY=fake
# Routage par moyen de paiement (vide = passerelle par défaut)
PAYMENTS_SEPA_GATEWAY=
PAYMENTS_CARD_GATEWAY=
PAYMENTS_FAKE_ENABLED=true
DONATION_MIN_CENTS=100
DONATION_MAX_CENTS=1000000

MOLLIE_API_KEY=test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Routage par devise (vide = PAYMENTS_GATEWAY). Ex. FCFA par carte via UBA, compte Ecobank via Ecobank.
PAYMENTS_XOF_CARD_GATEWAY=
PAYMENTS_XOF_ECOBANK_GATEWAY=
PAYMENTS_XAF_CARD_GATEWAY=
PAYMENTS_XAF_ECOBANK_GATEWAY=
PAYMENTS_NGN_CARD_GATEWAY=
PAYMENTS_NGN_ECOBANK_GATEWAY=
PAYMENTS_USD_CARD_GATEWAY=
PAYMENTS_USD_ECOBANK_GATEWAY=

# --- UBA (API SeerBit) — https://docs-uba.seerbitapi.com --------------------
UBA_PUBLIC_KEY=
UBA_SECRET_KEY=
UBA_BASE_URL=https://seerbitapi.com
UBA_CURRENCIES=NGN,XOF,XAF,USD
UBA_XOF_COUNTRY=SN
UBA_XAF_COUNTRY=CM
# true uniquement après confirmation par SeerBit que la page hébergée renvoie un authorizationCode
UBA_HOSTED_TOKENIZATION=false

# --- Ecobank Direct Debit — https://apimuat-developer.ecobank.com ----------
# Valeurs marquées (sandbox) : à relever dans la sandbox Ecobank avant mise en production.
ECOBANK_BASE_URL=
ECOBANK_TOKEN_PATH=/api/v2/token
ECOBANK_SUBSCRIPTION_KEY=
ECOBANK_SERVICE_CODE=
ECOBANK_CLIENT_ID=
ECOBANK_SECRET_KEY=
ECOBANK_AFFILIATE_CODE=
ECOBANK_SOURCE_CODE=
ECOBANK_SERVER_IP=
ECOBANK_USER_TYPE=CUSTOMER
ECOBANK_TOKEN_USER=
ECOBANK_TOKEN_PASSWORD=
# JSON {"sendOtp":"...","initiatePayment":"..."} (sandbox)
ECOBANK_REQUEST_TYPES={}
ECOBANK_SUCCESS_CODES=000,00,0,200
ECOBANK_CURRENCIES=XOF,XAF,NGN,USD

# SEPA : Identifiant Créancier SEPA (ICS) fourni par votre banque
SEPA_CREDITOR_ID=FR00ZZZ000000
SEPA_CREDITOR_NAME="${APP_NAME}"
SEPA_PRENOTIFICATION_DAYS=14

# --- Reçus fiscaux (cerfa 11580*05) — à valider avec votre expert-comptable -----
TAX_RECEIPTS_ENABLED=true
ORG_NAME="${APP_NAME}"
ORG_ADDRESS_LINE1="1 rue de l'Exemple"
ORG_POSTAL_CODE=75000
ORG_CITY=Paris
ORG_IDENTIFIER="RNA W000000000"
ORG_PURPOSE="Objet de l'organisme, tel que figurant dans les statuts."
ORG_QUALITY="Œuvre ou organisme d'intérêt général"
ORG_SIGNATORY_NAME="Prénom Nom"
ORG_SIGNATORY_ROLE="Président(e)"
# ORG_SIGNATURE_IMAGE=storage/app/private/signature.png
# 200 (particuliers) | 238 bis (entreprises) | 978 (IFI)
TAX_RECEIPT_CGI_ARTICLE=200
TAX_RECEIPT_REDUCTION_RATE=66

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
